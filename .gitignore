# Secrets
.env
*.env
kaggle.json

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Raw third-party dataset (9.6GB, CC BY 4.0 — re-downloaded via notebooks/train_kaggle.ipynb, not vendored)
data/amini/dataset/
data/amini/sample_images/
data/amini/*.zip

# Runtime-generated prediction history (SQLite + uploaded images)
history/

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp

# Spec Kit local state (per-machine, not part of the spec artifacts)
.specify/feature.json
.gitignore
Cacaufito.code-workspace

# Mira Animator tooling (local presentation-authoring tool, not part of the deliverable).
# The finished deck/video under decks/<name>/ IS the deliverable and stays tracked;
# only Mira's own installed skills/templates/config are excluded here.
.claude/skills/mira-*/
.claude/skills/_shared/
.claude/workflows/mira-*.js
.claude/settings.json
.mira/
mira-templates/
mira-plugins/
mira.config.json
*.uvicorn.log

